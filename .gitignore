.venv/
__pycache__/
*.pyc
.DS_Store
.env

# fetched by setup.sh from the public HackerRank Orchestrate repository
dataset/

# runtime state of the desk (cases, sandbox estate, ledger, certificates)
state/

# each agent folder keeps only its brief and its permissions in git;
# Switch Console writes the agent's credentials and session files next to them
agents/*/*
!agents/*/CLAUDE.md
!agents/*/AGENTS.md
!agents/*/.claude/
agents/*/.claude/*
!agents/*/.claude/settings.json
